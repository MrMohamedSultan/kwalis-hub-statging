# ==============================================================
# Environment variables for Vercel / self-hosted deployment
# Copy to .env.local for local dev, or add in Vercel dashboard.
# ==============================================================

# ---- Client (exposed to browser) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# ---- Server (server functions / SSR only — never exposed) ----
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
# SUPABASE_SERVICE_ROLE_KEY — DO NOT set locally or commit a real value.
# The service role key bypasses RLS. It is injected by the hosting platform
# at runtime and is only available in the hosted app.
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# ---- Optional: Lovable AI Gateway (only if you keep using Lovable AI) ----
LOVABLE_API_KEY=lov_xxxxxxxxxxxxxxxxxxxxxx
