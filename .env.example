# ==============================================================
# Environment variables for Vercel / self-hosted deployment
# Copy to .env.local for local dev, or add in Vercel dashboard.
# ==============================================================

# ---- Client (exposed to browser) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# ---- Server (server functions / SSR only — never exposed) ----
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
# SUPABASE_SERVICE_ROLE_KEY — DO NOT set locally or commit a real value.
# The service role key bypasses RLS. It is injected by the hosting platform
# at runtime and is only available in the hosted app.
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# ---- Optional: Lovable AI Gateway (only if you keep using Lovable AI) ----
LOVABLE_API_KEY=lov_xxxxxxxxxxxxxxxxxxxxxx

# ---- Server-only, platform features (db/pending/195) — never prefix with VITE_ ----
# NOTIFY_DISPATCH_SECRET=        # cron secret for /api/public/notifications-dispatch
# APP_BASE_URL=https://kwalis.example.com
# MAIL_FROM="Kwalis HUB <noreply@example.com>"
# MAIL_PROVIDER=smtp             # or resend
# SMTP_HOST=  SMTP_PORT=587  SMTP_USER=  SMTP_PASS=
# RESEND_API_KEY=
# Report tabs: VITE_REPORT_TABS_ENABLE=gosi / VITE_REPORT_TABS_DISABLE=qfe,vat

# ---- Server-only: Demo Mode account (demo@kwalishub.com) ----
# Password of the presentation demo account, at least 12 characters. Set it in
# the hosting platform's secrets; never commit a real value. When unset, demo
# provisioning and the demo self-healing sign-in are disabled.
# DEMO_ACCOUNT_PASSWORD=
