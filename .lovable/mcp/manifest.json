{
  "version": 1,
  "sdk_version": "0.22.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://zfycacfkkwcfmjrlxzgm.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "kwalis-hub-mcp",
      "version": "0.1.0",
      "title": "Kwalis HUB"
    },
    "tools": [
      {
        "name": "list_projects",
        "title": "List my projects",
        "description": "List every Kwalis HUB production the signed-in user can access, with code, name, status, and budget total.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_project_summary",
        "title": "Get project financial summary",
        "description": "Return budget total, actual spent, remaining, invoice count, and payroll totals for a Kwalis HUB project.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string",
              "format": "uuid",
              "description": "The project UUID (from list_projects)."
            }
          },
          "required": [
            "project_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_recent_invoices",
        "title": "List recent invoices",
        "description": "Return the most recent invoices for a project, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string",
              "format": "uuid",
              "description": "Project UUID."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "description": "Max invoices to return."
            }
          },
          "required": [
            "project_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_payment_requests",
        "title": "List payment requests",
        "description": "List payment requests for a project, optionally filtered by status (draft, pending, approved, rejected, executed).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string",
              "format": "uuid",
              "description": "Project UUID."
            },
            "status": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "draft",
                    "pending",
                    "approved",
                    "rejected",
                    "executed"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional status filter; null returns all statuses."
            }
          },
          "required": [
            "project_id",
            "status"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
